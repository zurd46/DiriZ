{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiriZ",
  "version": "0.1.0",
  "identifier": "de.diriz.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiriZ — Control Tower",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
