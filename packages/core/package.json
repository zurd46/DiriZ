{
  "name": "@diriz/core",
  "version": "0.1.0",
  "private": true,
  "description": "DiriZ Core — Fastify-Server (127.0.0.1:8787): Provider-Schicht, Routing-Engine, Ausführungs-Engine, SQLite, SSE.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build --workspace @diriz/shared && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run build --workspace @diriz/shared && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@diriz/shared": "*",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
